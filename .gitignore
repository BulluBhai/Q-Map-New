!tests/fixtures/source_samples/Nifty_3min_02Jan23-30Oct26.parquet
!tests/fixtures/source_samples/Nifty_5min_02Jan23-30Oct26.parquet
!tests/fixtures/source_samples/Nifty_15min_02Jan23-30Oct26.parquet
